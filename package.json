{
  "name": "booking-api",
  "version": "1.0.0",
  "description": "Appointment booking mini-API (NestJS, PostgreSQL, Prisma, Socket.IO, OpenAPI)",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.check.json",
    "socket:listen": "tsx scripts/socket-listen.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*.e2e-spec.ts$",
    "transform": {
      "^.+.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "setupFiles": [
      "<rootDir>/test/use-test-db.ts"
    ],
    "testTimeout": 30000
  }
}
